#!/usr/sbin/nft -f

flush ruleset

table inet aegis_filter {
	set blocked_clients {
		type ipv4_addr
		flags timeout
		timeout 2m
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		iifname "enp0s8" ip saddr @blocked_clients drop
		ct state invalid drop
		ct state established,related accept
		iifname "enp0s8" oifname "enp0s3" ip saddr 10.77.0.0/24 ip daddr != {
			0.0.0.0/8,
			10.0.0.0/8,
			100.64.0.0/10,
			127.0.0.0/8,
			169.254.0.0/16,
			172.16.0.0/12,
			192.0.0.0/24,
			192.0.2.0/24,
			192.88.99.0/24,
			192.168.0.0/16,
			198.18.0.0/15,
			198.51.100.0/24,
			203.0.113.0/24,
			224.0.0.0/4,
			240.0.0.0/4
		} accept
	}
}

table ip aegis_nat {
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "enp0s3" ip saddr 10.77.0.0/24 masquerade
	}
}