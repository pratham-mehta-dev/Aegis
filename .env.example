# Aegis configuration. Copy to .env and fill in values. NEVER commit .env.

PORT=4000
NODE_ENV=development

# Public URL of the frontend (used in email links). In dev with the API serving
# the built frontend this is just the API origin.
APP_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:4000

# Comma-separated origins allowed to call the API with credentials.
# Add http://localhost:5173 if you run the Vite dev server.
CORS_ORIGINS=http://localhost:4000,http://localhost:5173

# REQUIRED: two different high-entropy secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=
PENDING_2FA_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
TOTP_ISSUER=Aegis

# Flask ML service (loopback only)
ML_SERVICE_URL=http://127.0.0.1:5000

# Mail. If SMTP_HOST is empty AND NODE_ENV is not production, emails are
# written to the console and data/outbox.log instead of being sent (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Aegis Security <no-reply@aegis.local>"
