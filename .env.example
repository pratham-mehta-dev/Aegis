# Aegis configuration. Copy to .env and fill in values. NEVER commit .env.

PORT=4001
NODE_ENV=development

# Public URL of the frontend (used in email links).
APP_BASE_URL=http://localhost:4001
FRONTEND_URL=http://localhost:4001

# Optional Google OAuth web client. Local callback goes through single server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4001/api/auth/google/callback

# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:4001

# REQUIRED: two different high-entropy secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=
PENDING_2FA_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
TOTP_ISSUER=Aegis

# Flask ML service (loopback only)
ML_SERVICE_URL=http://127.0.0.1:5000

# Required to accept Suricata EVE events. Generate a unique random value.
SURICATA_INGEST_TOKEN=

# Mail. If SMTP_HOST is empty AND NODE_ENV is not production, emails are
# written to the console and data/outbox.log instead of being sent (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Aegis Security <no-reply@aegis.local>"
